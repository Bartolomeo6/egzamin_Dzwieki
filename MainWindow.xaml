<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
         Title="MojeDźwięki, Wykonał: 000000000000" Height="450" Width="800" Background="#2E8B57">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition Width="2*"></ColumnDefinition>
            <ColumnDefinition Width="4*"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Button Height="70" Width="90" HorizontalAlignment="Left" Click="Button_Click_2">
            <Image Source="obraz3.png" Height="70"></Image>
        </Button>
        <Image Source="obraz.png" Grid.Column="1"></Image>
        <Button Height="70" Width="90" HorizontalAlignment="Right" Grid.Column="3" Click="Button_Click_1">
            <Image Source="obraz2.png" Height="70"></Image>
        </Button>

        <TextBlock Text="Nazwa wykonawcy" x:Name="wykonawca_name" Grid.Column="2" Foreground="White" FontSize="50"></TextBlock>
        <TextBlock Text="Tytuł albumu" x:Name="tytul_album" Grid.Column="2" Foreground="White" FontSize="30" FontStyle="Italic" Margin="0,59,0,85" Grid.RowSpan="2"></TextBlock>
        <TextBlock Text="Liczba utworów" x:Name="liczba_utw" Grid.Column="2" Foreground="#61D918" FontSize="20" Margin="0,112,0,33" Grid.RowSpan="2"/>
        <TextBlock Text="Rok wydania" x:Name="rok_wydania" Grid.Column="2" Foreground="#61D918" FontSize="20" Margin="165,112,29,32"/>

        <Label Width="174" Height="35" FontSize="20" VerticalAlignment="Bottom" HorizontalAlignment="Left" x:Name="liczba_pobran" Foreground="#61D918" Grid.ColumnSpan="2" Margin="26,0,0,4"/>
        <Button Click="Button_Click" FontWeight="Bold" Height="30" Width="80" Background="#61D918" FontSize="20" VerticalAlignment="Bottom" Grid.Column="1" HorizontalAlignment="Right">Pobierz</Button>
    </Grid>
</Window>
